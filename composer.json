{
    "name": "printmelo/printmelo-php",
    "description": "Official PHP SDK for the Printmelo API: print from your own software to printers on location.",
    "type": "library",
    "license": "MIT",
    "keywords": ["printmelo", "printing", "cloud printing", "labels", "zpl", "printnode", "api", "sdk"],
    "homepage": "https://www.printmelo.com",
    "support": {
        "docs": "https://api.printmelo.com/docs",
        "issues": "https://github.com/printmelo/printmelo-php/issues"
    },
    "authors": [
        {
            "name": "Printmelo",
            "homepage": "https://www.printmelo.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5 || ^8.0",
        "guzzlehttp/psr7": "^2.4 || ^3.0",
        "psr/http-client": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Printmelo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Printmelo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
